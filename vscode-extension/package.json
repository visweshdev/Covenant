{
  "name": "covenant",
  "displayName": "Covenant",
  "description": "See and manage the rules Covenant enforces on coding agents: live violations, protected files, approvals.",
  "version": "0.1.0",
  "license": "MIT",
  "icon": "media/icon.png",
  "publisher": "covenant",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "ai",
    "agents",
    "claude",
    "policy",
    "guardrails"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:covenant.yaml",
    "onView:covenant.rules"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "covenant",
          "title": "Covenant",
          "icon": "media/covenant.svg"
        }
      ]
    },
    "views": {
      "covenant": [
        {
          "id": "covenant.rules",
          "name": "Rules"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "covenant.rules",
        "contents": "No covenant.yaml in this workspace.\n[Compile rules from an instruction](command:covenant.compile)",
        "when": "!covenant.hasCovenant"
      }
    ],
    "commands": [
      {
        "command": "covenant.refresh",
        "title": "Covenant: Check Now",
        "icon": "$(refresh)"
      },
      {
        "command": "covenant.runTests",
        "title": "Covenant: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "covenant.approve",
        "title": "Covenant: Approve Rules and Start Task",
        "icon": "$(check-all)"
      },
      {
        "command": "covenant.compile",
        "title": "Covenant: Compile Rules from Instruction"
      },
      {
        "command": "covenant.amend",
        "title": "Covenant: Add a Rule to the Current Task",
        "icon": "$(add)"
      },
      {
        "command": "covenant.init",
        "title": "Covenant: Set Up This Repo (Hooks + Start)"
      },
      {
        "command": "covenant.openRule",
        "title": "Covenant: Open Rule"
      },
      {
        "command": "covenant.showLog",
        "title": "Covenant: Show Activity Log"
      },
      {
        "command": "covenant.openViolation",
        "title": "Covenant: Show Violation"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "covenant.refresh",
          "when": "view == covenant.rules",
          "group": "navigation@1"
        },
        {
          "command": "covenant.runTests",
          "when": "view == covenant.rules",
          "group": "navigation@2"
        },
        {
          "command": "covenant.approve",
          "when": "view == covenant.rules",
          "group": "navigation@3"
        },
        {
          "command": "covenant.amend",
          "when": "view == covenant.rules",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "covenant.openRule",
          "when": "false"
        },
        {
          "command": "covenant.openViolation",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Covenant",
      "properties": {
        "covenant.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python that has Covenant installed (runs `python -m covenant`)."
        },
        "covenant.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-check the rules when a file is saved. The check never changes files."
        },
        "covenant.offlineCompile": {
          "type": "boolean",
          "default": false,
          "description": "Compile instructions with the offline extractor instead of Claude."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "tsc -p . && node --test \"out/test/*.test.js\"",
    "package": "tsc -p . && vsce package",
    "test:e2e": "tsc -p . && node out/test-e2e/run.js"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visweshdev/Covenant"
  },
  "homepage": "https://github.com/visweshdev/Covenant",
  "bugs": {
    "url": "https://github.com/visweshdev/Covenant/issues"
  },
  "galleryBanner": {
    "color": "#f4efe6",
    "theme": "light"
  }
}
